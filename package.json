{
  "name": "echo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "sprites": "python3 tools/gen_sprites.py",
    "test": "vitest run",
    "solve": "vitest run --config tools/solver/vitest.config.ts tools/solver/cases.solve.ts",
    "solve:replay": "vitest run --config tools/solver/vitest.config.ts tools/solver/replay.solve.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
